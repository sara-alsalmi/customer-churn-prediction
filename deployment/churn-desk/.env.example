# Copy to .env and fill in. With no keys, the app runs fully offline:
# a scripted customer + the browser's own voice.

# Claude plays the customer and scores each reply
ANTHROPIC_API_KEY=
CUSTOMER_CLAUDE_MODEL=
CUSTOMER_CLAUDE_EFFORT=low

# ElevenLabs gives the customer a real voice and transcribes the employee
ELEVENLABS_API_KEY=
# Pick Arabic voices from your ElevenLabs Voice Library and paste their IDs
ELEVENLABS_VOICE_MALE=
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# Set to 1 to ignore the keys above and stay offline (for demos without internet)
FORCE_OFFLINE=0
